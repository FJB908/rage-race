{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        "$token": {
          ".read": "auth != null",
          "p": {
            "$uid": {
              ".write": "auth != null && ($uid === auth.uid || $uid.beginsWith('bot_'))",
              ".validate": "newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber()"
            }
          },
          "ev": {
            "$id": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['k', 'by'])"
            }
          }
        }
      }
    }
  }
}
