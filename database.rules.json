{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        "$token": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber()"
          }
        }
      }
    }
  }
}
