rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every player may read and write only their own save document, with a fixed shape and a size cap.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'ts', 'blob', 'name', 'xp', 'mmr', 'rp', 'season', 'updatedAt'])
        && request.resource.data.blob is string && request.resource.data.blob.size() < 300000
        && request.resource.data.name is string && request.resource.data.name.size() <= 16;
      allow delete: if request.auth != null && request.auth.uid == uid;       // 'Delete my account' in the app
    }
    // Public card of every player (name, look, level, rank). Only the owner writes it; any signed-in player can read it (friend search by code).
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'code', 'look', 'lvl', 'rk', 'tier', 'seen'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Friendship = one document per pair (id = sorted uids). Only the other person can accept.
    match /friendships/{id} {
      allow get: if request.auth != null && request.auth.uid in id.split('_');                      // the id is the two uids, so a pair that does not exist yet can be checked
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2
        && request.resource.data.requester == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if request.auth != null && request.auth.uid in resource.data.members && request.auth.uid != resource.data.requester
        && request.resource.data.status == 'accepted' && request.resource.data.members == resource.data.members;
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
    // Party invites: anyone can send one, only the receiver reads or removes it.
    match /invites/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    // Party lobby (host controls the party document; members and results are written by the player themselves).
    match /parties/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.host == request.auth.uid;
      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid || get(/databases/$(database)/documents/parties/$(code)).data.host == request.auth.uid);
      }
      match /results/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Ranked record: written only by the server (Cloud Functions), readable by its owner.
    match /ranked/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }
    match /matches/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
